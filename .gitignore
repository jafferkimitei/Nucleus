# Dependencies (npm workspaces hoists most of this to the root, but a
# workspace can still get its own node_modules for un-hoistable deps)
node_modules
**/node_modules

# Build output
dist
dist-ssr
**/dist
**/dist-ssr
*.local

# Test artifacts
coverage
**/coverage
playwright-report
**/playwright-report
test-results
**/test-results
blob-report
**/blob-report
*.tsbuildinfo

# Vercel CLI local project link (org/project IDs, not for version control)
.vercel
**/.vercel

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
